{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Airflow Simulator",
  "version": "0.7.0",
  "identifier": "com.cirovic.airflowsim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PC Airflow Simulator",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#141518"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNjE4QUM5RjE4REY4NDQKUldSRStJM3h5WXBoWW5zRFA4aW1WSWsyV3k3c3o2b3JPUk9zRzlpMHVGK0tVZVFMcEtCY3NSUy8K",
      "endpoints": [
        "https://github.com/cirovic-d/AirFlowSim/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
